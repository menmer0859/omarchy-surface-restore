#!/usr/bin/bash

# pam_exec starts the helper in a new session, so /dev/tty is unavailable even
# when sudo was launched from an interactive terminal. Use PAM_TTY, which
# pam_exec exports, and accept only local Linux virtual or pseudoterminals.
if [[ -n ${PAM_TTY:-} ]]; then
  pam_tty=${PAM_TTY#/dev/}
  if [[ ! $pam_tty =~ ^(pts/[0-9]+|tty[0-9]+)$ ]]; then
    printf '%s\n' 'Face authentication skipped: PAM_TTY is not a supported local terminal.' >&2
    exit 1
  fi

  terminal_device="/dev/$pam_tty"
  if [[ ! -c $terminal_device ]] || ! { exec 3<>"$terminal_device"; } 2>/dev/null; then
    printf '%s\n' 'Face authentication skipped: PAM_TTY is unavailable.' >&2
    exit 1
  fi
elif ! { exec 3<>/dev/tty; } 2>/dev/null; then
  # Keep direct interactive execution useful for local diagnostics. PAM always
  # provides PAM_TTY; without it, non-interactive calls fail closed.
  printf '%s\n' 'Face authentication skipped: no terminal is available.' >&2
  exit 1
fi

# Read only a bounded display-language code from the authenticating user's
# Omarchy preference. Python isolated mode ignores PYTHONPATH and user site code.
# PAM invokes an absolute root-owned path. Derive its sibling using only
# shell builtins: inherited PATH must never choose a privileged Python program.
case "${BASH_SOURCE[0]}" in
  /*) locale_helper="${BASH_SOURCE[0]%/*}/omarchy-face-auth-locale" ;;
  *) locale_helper=/usr/local/libexec/omarchy-face-auth-locale ;;
esac
prompt='Use face authentication? [y/N] '
if [[ -f "$locale_helper" ]]; then
  translated=$(/usr/bin/python3 -I "$locale_helper" --user "${PAM_USER:-${SUDO_USER:-}}" 2>/dev/null) && prompt=$translated
fi
printf '%s' "$prompt" >&3
answer=''
if ! IFS= read -r -t 30 answer <&3; then
  exit 1
fi

case "$answer" in
  y|Y)
    if [[ -f "$locale_helper" ]]; then
      /usr/bin/python3 -I "$locale_helper" --user "${PAM_USER:-${SUDO_USER:-}}" --guidance >&3 2>/dev/null
      printf '\n' >&3
    fi
    exit 0 ;;
  *) exit 1 ;;
esac
